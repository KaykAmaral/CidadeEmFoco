# URL JDBC usada ao rodar localmente (./mvnw spring-boot:run).
# Ao usar Docker Compose, o docker-compose.yml sobrescreve esta variavel
# automaticamente para apontar para o host "db" (nao e necessario editar aqui).
DB_URL=jdbc:mysql://localhost:3306/cidade_em_foco?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
# Obrigatorio e nao pode ficar vazio se for usar Docker Compose
# (a imagem oficial do MySQL exige senha de root).
DB_PASSWORD=troque_pela_senha_local
SERVER_PORT=8080
# Gere uma chave Base64 aleatoria com pelo menos 32 bytes e cole abaixo.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440
OCCURRENCE_IMAGE_DIR=uploads/occurrences
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Usada apenas pelo servico "db" do docker-compose.yml para nomear o schema
# criado automaticamente pelo container do MySQL. Mantenha igual ao nome do
# banco presente em DB_URL.
MYSQL_DATABASE=cidade_em_foco
