# Banco MySQL gratuito criado no Aiven.
DB_URL=jdbc:mysql://SEU_HOST_AIVEN:SUA_PORTA/defaultdb?sslmode=require&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=SENHA_GERADA_PELO_AIVEN

# Gere uma chave Base64 exclusiva para producao com pelo menos 32 bytes.
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_BASE64_FORTE
JWT_EXPIRATION_MINUTES=1440

# Recuperacao de migration: ative uma vez e retorne para false apos o deploy.
FLYWAY_REPAIR_ON_START=false

# URL HTTPS do frontend publicado no Cloudflare Workers.
CORS_ALLOWED_ORIGINS=https://SEU-PROJETO.workers.dev

# Render gratuito possui pouca memoria; este limite deixa espaco para o sistema.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=25

# Fotos persistentes no Cloudinary.
IMAGE_STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=SEU_CLOUD_NAME
CLOUDINARY_API_KEY=SUA_API_KEY
CLOUDINARY_API_SECRET=SEU_API_SECRET
CLOUDINARY_FOLDER=cidade-em-foco/occurrences

RESOLVED_MAP_VISIBILITY=24h
TEMPORARY_EVENT_LIFETIME=2d
AUTO_RESOLUTION_INTERVAL=5m
AUTO_RESOLUTION_INITIAL_DELAY=5m
OCCURRENCE_GROUPING_WINDOW_NATURAL=2d
OCCURRENCE_GROUPING_WINDOW_INFRASTRUCTURE=30d
OCCURRENCE_GROUPING_RADIUS_METERS=25

ALERT_REALTIME_CONNECTION_TIMEOUT=30m
ALERT_REALTIME_REFRESH_INTERVAL=30s
ALERT_CLEANUP_INTERVAL=5m
ALERT_CLEANUP_INITIAL_DELAY=5m

WHATSAPP_QUEUE_SYNC_INTERVAL=1m
WHATSAPP_QUEUE_SYNC_INITIAL_DELAY=1m
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=cidade_em_foco_alerta_climatico
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TIMEZONE=America/Sao_Paulo
WHATSAPP_PROCESS_INTERVAL=30s
WHATSAPP_PROCESS_INITIAL_DELAY=30s
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_BATCH_SIZE=20
