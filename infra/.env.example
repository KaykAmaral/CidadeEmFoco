# Variaveis usadas pelo Docker Compose em infra/docker-compose.yml.
DB_USERNAME=root
DB_PASSWORD=troque_pela_senha_local
SERVER_PORT=8080

# Armazenamento local no desenvolvimento. Use cloudinary no Render.
IMAGE_STORAGE_TYPE=local
OCCURRENCE_IMAGE_DIR=uploads/occurrences
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cidade-em-foco/occurrences

# Gere uma chave Base64 aleatoria com pelo menos 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# Tempo que um pin resolvido continua visivel no mapa (ex.: 30m, 12h, 2d).
RESOLVED_MAP_VISIBILITY=24h

# Eventos naturais temporarios sao encerrados apos este prazo.
TEMPORARY_EVENT_LIFETIME=6h
AUTO_RESOLUTION_INTERVAL=5m
AUTO_RESOLUTION_INITIAL_DELAY=5m

# Criterios para juntar relatos semelhantes em um caso principal.
OCCURRENCE_GROUPING_WINDOW=2h
OCCURRENCE_GROUPING_RADIUS_METERS=500

# Conexao SSE usada para avisar o frontend sobre mudancas nos alertas.
ALERT_REALTIME_CONNECTION_TIMEOUT=30m
ALERT_REALTIME_REFRESH_INTERVAL=30s
ALERT_CLEANUP_INTERVAL=5m
ALERT_CLEANUP_INITIAL_DELAY=5m

# Sincronizacao da fila de notificacoes com os alertas ativos.
WHATSAPP_QUEUE_SYNC_INTERVAL=1m
WHATSAPP_QUEUE_SYNC_INITIAL_DELAY=1m

# Envio da fila pela WhatsApp Cloud API. Ative somente depois de configurar a Meta.
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=cidade_em_foco_alerta_climatico
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TIMEZONE=America/Sao_Paulo
WHATSAPP_PROCESS_INTERVAL=30s
WHATSAPP_PROCESS_INITIAL_DELAY=30s
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_BATCH_SIZE=20

CORS_ALLOWED_ORIGINS=http://localhost:5173
MYSQL_DATABASE=cidade_em_foco
