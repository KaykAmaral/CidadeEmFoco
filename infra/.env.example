# Variaveis usadas pelo Docker Compose em infra/docker-compose.yml.
DB_USERNAME=root
DB_PASSWORD=troque_pela_senha_local
SERVER_PORT=8080

# Gere uma chave Base64 aleatoria com pelo menos 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# Tempo que um pin resolvido continua visivel no mapa (ex.: 30m, 12h, 2d).
RESOLVED_MAP_VISIBILITY=24h

# Eventos naturais temporarios sao encerrados apos este prazo.
TEMPORARY_EVENT_LIFETIME=6h
AUTO_RESOLUTION_INTERVAL=5m
AUTO_RESOLUTION_INITIAL_DELAY=5m

# Criterios para juntar relatos semelhantes em um caso principal.
OCCURRENCE_GROUPING_WINDOW=2h
OCCURRENCE_GROUPING_RADIUS_METERS=500

# Conexao SSE usada para avisar o frontend sobre mudancas nos alertas.
ALERT_REALTIME_CONNECTION_TIMEOUT=30m
ALERT_REALTIME_REFRESH_INTERVAL=30s
ALERT_CLEANUP_INTERVAL=5m
ALERT_CLEANUP_INITIAL_DELAY=5m

CORS_ALLOWED_ORIGINS=http://localhost:5173
MYSQL_DATABASE=cidade_em_foco
